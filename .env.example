# Optional Yahoo credentials for live league tools. Offline analysis does not
# require them. See docs/YAHOO_API_SETUP.md before requesting access.
YAHOO_CLIENT_ID=your_consumer_key_here
YAHOO_CLIENT_SECRET=your_consumer_secret_here
YAHOO_ACCESS_TOKEN=your_access_token_here
YAHOO_REFRESH_TOKEN=your_refresh_token_here

# Yahoo User GUID (required only for live multi-league support)
# Get from https://api.login.yahoo.com/openid/v1/userinfo after OAuth
YAHOO_GUID=your_yahoo_guid_here

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/yahoo_fantasy_football.log

# MCP Server Configuration
MCP_SERVER_NAME=yahoo-fantasy-football
MCP_SERVER_VERSION=1.0.0

# Parallel Processing
MAX_WORKERS=10
ASYNC_TIMEOUT_SECONDS=30

# Feature flags for optional live enrichment
ENABLE_ADVANCED_STATS=true
ENABLE_WEATHER_DATA=true
ENABLE_INJURY_REPORTS=true

# Optional Reddit credentials. Use only after explicit Data API approval.
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USERNAME=your_reddit_username

# Optional FantasyPros API (explicit opt-in supplemental source)
# Request a key at https://www.fantasypros.com/api-data/
FANTASYPROS_API_KEY=
FANTASYPROS_API_BASE_URL=https://api.fantasypros.com/public/v2/json
# Optional local FantasyPros CSV exports. When set, these replace the limited API.
FANTASYPROS_PROJECTIONS_PATH=
FANTASYPROS_QB_PROJECTIONS_PATH=
FANTASYPROS_RANKINGS_PATH=

# Optional private FFA exports used for source blending
FFA_PROJECTIONS_PATH=
FFA_CUSTOM_RANKINGS_PATH=

# Optional local team-environment context. The JSON should contain
# team offensive-line ranks and Vegas win totals; each is capped at 2.5%.
TEAM_ENVIRONMENT_PATH=

# Yahoo OAuth Settings
YAHOO_REDIRECT_URI=https://localhost:8000/callback
YAHOO_CALLBACK_PORT=8000
YAHOO_CALLBACK_HOST=localhost
YAHOO_TOKEN_TIME=0
YAHOO_TOKEN_TYPE=bearer

# Remote MCP Server Configuration (for Render deployment)
DEBUG=true
ALLOWED_CLIENT_IDS=*
ALLOWED_REDIRECT_URIS=*
OAUTH_CLIENT_SECRET=secure-secret-change-this-in-production
CORS_ORIGINS=*
RENDER_EXTERNAL_URL=https://your-app-name.onrender.com
